{
  "name": "opengamep2p",
  "version": "0.2.0",
  "description": "Host-authoritative P2P multiplayer for browser games, powered by Trystero",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run test:types && npm test",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/api-types.ts",
    "test:browser": "node tests/browser.mjs",
    "dev": "vite --host 0.0.0.0",
    "build:demo": "vite build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.2.0",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "multiplayer",
    "trystero",
    "netcode"
  ]
}
