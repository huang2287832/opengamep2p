# Copy to .env.local for testing, then restart Vite or rebuild/redeploy the demo.
# VITE_* values are visible in browser bundles: use short-lived TURN credentials.
# Never put a provider's permanent API key here.
# Leave these empty to use the built-in freeSTUN public TURN fallback.
# Set all three to replace it with your own provider.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# all: try direct connectivity and TURN; relay: force TURN for diagnosis only.
VITE_ICE_TRANSPORT_POLICY=all

# Optional discovery/signaling relay; changing it does not replace TURN.
VITE_RELAY_URL=
